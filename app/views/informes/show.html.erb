<% months = %w[Enero Febrero Marzo Abril Mayo Junio Julio Agosto Septiembre Octubre Noviembre Diciembre] %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 my-8">

  <div class="flex items-center justify-between mb-6">
    <%= link_to "Volver atrás",
                informes_path,
                class: "inline-flex items-center px-4 py-2 border border-transparent \
                        text-base leading-6 font-medium rounded-md text-blue-400 \
                        bg-gray-800 hover:bg-blue-800 hover:text-white focus:outline-none \
                        focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition duration-150 ease-in-out" %>

    <%= link_to "Modificar",
                edit_informe_path(@informe),
                class: "inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 \
                        text-gray-900 font-bold rounded-md focus:outline-none focus:shadow-outline" %>
  </div>

  <div class="bg-gray-900 p-6 rounded-lg shadow-md text-gray-200 space-y-6">

    <h1 class="text-2xl font-bold">
      Detalle Informes <%= "#{months[@informe.month - 1]} #{@informe.year}" %>
    </h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

      <div class="bg-gray-800 rounded-md p-4 sm:col-span-2">
        <h2 class="text-sm uppercase tracking-wide text-gray-400">Empresa mandante</h2>
        <p class="text-xl font-semibold"><%= @informe.mandante_nombre.presence || "—" %></p>
        <p class="text-xs text-gray-500 mt-1">RUT: <%= @informe.mandante_rut %></p>
      </div>

      <div class="bg-gray-800 rounded-md p-4">
        <h2 class="text-sm uppercase tracking-wide text-gray-400">Fecha</h2>
        <p class="text-xl font-semibold"><%= @informe.fecha&.strftime("%d-%m-%Y") || "—" %></p>
      </div>

      <div class="bg-gray-800 rounded-md p-4">
        <h2 class="text-sm uppercase tracking-wide text-gray-400">Período</h2>
        <p class="text-xl font-semibold">
          <%= "#{months[@informe.month - 1]} #{@informe.year}" %>
        </p>
      </div>

      <div class="bg-gray-800 rounded-md p-4">
        <h2 class="text-sm uppercase tracking-wide text-gray-400">Número de informes</h2>
        <p class="text-xl font-semibold"><%= @informe.n_informes %></p>
      </div>

      <div class="bg-gray-800 rounded-md p-4">
        <h2 class="text-sm uppercase tracking-wide text-gray-400">Valor individual (UF)</h2>
        <p class="text-xl font-semibold">
          <%= number_with_precision(@informe.valor_unitario, precision: 2) %>
        </p>
      </div>

      <div class="bg-gray-800 rounded-md p-4 sm:col-span-2">
        <h2 class="text-sm uppercase tracking-wide text-gray-400">Valor total (UF)</h2>
        <p class="text-2xl font-bold">
          <%= number_with_precision(@informe.total, precision: 2) %>
          <% if @total_clp %>
            <span class="block text-lg text-gray-400 font-normal">
              ≈ <%= number_to_currency(@total_clp, unit: "$", precision: 0, delimiter: ".") %> CLP
            </span>
          <% else %>
            <span class="block text-sm text-red-400 font-normal">
              UF no disponible para este período
            </span>
          <% end %>
        </p>
      </div>

    </div>
  </div>
</div>